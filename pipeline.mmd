flowchart LR
    source["Downloaded PDFs<br/>assets/regulations/"]

    subgraph PRE["Pre-processing: regulation flow"]
        original["original/<br/>Source PDFs"]
        convert["Convert<br/>utils/pdf_to_md.py<br/>PDF to Markdown"]
        converted["converted/<br/>Markdown outputs"]
        cleanReg["Clean regulation<br/>cleanup_markdown.py<br/>Remove gazette headers/footers"]
        cleaned["cleaned/<br/>Clean Markdown"]
        parseReg["Parse regulation<br/>regulation_parser.py<br/>Markdown to structured JSON"]
        parsed["parsed/<br/>Regulation JSON"]

        original --> convert --> converted --> cleanReg --> cleaned --> parseReg --> parsed
    end

    subgraph AMEND["Pre-processing: amendment flow"]
        cleanAmend["Clean amendment<br/>cleanup_markdown.py<br/>Normalize notification text"]
        amendCleaned["cleaned/amendments/<br/>Clean amendment Markdown"]
        parseAmend["Parse amendment<br/>amendment_parser.py<br/>LLM extracts dated changes"]
        amendParsed["parsed/amendments/<br/>Amendment JSON"]
        apply["Apply amendments<br/>apply_amendment.py<br/>LLM applies old-to-new changes"]

        cleanAmend --> amendCleaned --> parseAmend --> amendParsed --> apply
    end

    parsed --> apply
    apply --> final["post_amendment/<br/>Final regulation JSON"]

    subgraph ING["Ingestion"]
        load["Load and validate<br/>persist_embeddings.py<br/>Read Regulation schema"]
        chunks["Create chunks<br/>chunks_creator.py<br/>Token-based text chunks + metadata"]
        embedDocs["Embed chunks<br/>create_embeddings.py<br/>OpenRouter embedding model"]
        persist["Persist vectors<br/>persist_embeddings.py<br/>Upsert deterministic Chroma IDs"]
        ingestionMeta["ingestion/<br/>Run metadata"]
        db[("db/<br/>Chroma: fssai_regulations")]

        load --> chunks --> embedDocs --> persist --> ingestionMeta
        persist --> db
    end

    final --> load

    subgraph RET["Retrieval"]
        question["User question"]
        embedQuery["Embed query<br/>create_embeddings.py<br/>Same embedding model"]
        search["Retrieve top-k<br/>retrieval/retrieve.py<br/>Nearest Chroma chunks"]
        results["Retrieved chunks<br/>Text + metadata + distance"]

        question --> embedQuery --> search --> results
    end

    db --> search
    source --> original
    converted --> cleanAmend

    manifest["manifest.json<br/>Tracks hashes and skips unchanged stages"]
    manifest -.-> convert
    manifest -.-> cleanReg
    manifest -.-> cleanAmend
    manifest -.-> parseReg
    manifest -.-> parseAmend
    manifest -.-> apply
    manifest -.-> load

    classDef deterministic fill:#e8f3ff,stroke:#2b6cb0,color:#102a43
    classDef llm fill:#fff4db,stroke:#b7791f,color:#5f370e
    classDef store fill:#e8fff1,stroke:#2f855a,color:#163b26
    classDef control fill:#f3e8ff,stroke:#805ad5,color:#44337a

    class convert,cleanReg,cleanAmend,parseReg,load,chunks,embedDocs,embedQuery,search deterministic
    class parseAmend,apply llm
    class db,persist,results store
    class manifest control
